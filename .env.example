# Firebase web configuration. Copy to `.env.local` and fill in the values from
# the Firebase console (Project settings → General → Your apps → SDK setup).
# If any of these is missing the app still works fully offline; it just skips
# syncing profile metadata to Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
